<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet id="20240712_create_member"
		author="henrio septiano">
		<createTable ifNotExists="true" tableName="members">
			<column name="member_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="member_name" type="varchar(100)">
				<constraints nullable="false" />
			</column>
			<column name="member_type" type="varchar(20)">
				<constraints nullable="false" />
			</column>
			<column name="api_key" type="varchar(255)">
				<constraints nullable="false" unique="true" />
			</column>
			<column name="is_deleted" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="project_id" type="bigint">
				<constraints nullable="false"
					foreignKeyName="fk_member_project"
					references="projects(project_id)" />
			</column>
		</createTable>
	</changeSet>
</databaseChangeLog>