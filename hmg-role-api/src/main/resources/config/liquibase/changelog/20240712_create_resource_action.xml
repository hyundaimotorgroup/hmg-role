<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet id="20240712_create_resource_action"
		author="henrio septiano">
		<createTable ifNotExists="true"
			tableName="resource_actions">
			<column name="resource_action_id" type="bigint"
				autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="action_name" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="resource_type_id" type="bigint">
				<constraints nullable="false"
					foreignKeyName="fk_resourceaction_resourcetype"
					references="resource_types(resource_type_id)" />
			</column>
			<column name="is_deleted" type="boolean">
				<constraints nullable="false" />
			</column>
		</createTable>
	</changeSet>
</databaseChangeLog>