<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="20240724_alter_policy" author="Rais Rahim">

		<renameColumn tableName="policies"
			oldColumnName="policy_key" newColumnName="old_policy_key"
			columnDataType="varchar(255)" />

		<addColumn tableName="policies">
			<column name="policy_key" type="varchar(255)"
				valueComputed="old_policy_key" />
		</addColumn>

		<addColumn tableName="policies">
			<column name="project_id" type="bigint">
				<constraints foreignKeyName="fk_policies_projects"
					references="projects(project_id)" />
			</column>
		</addColumn>

		<addUniqueConstraint tableName="policies"
			constraintName="uk_policy_project"
			columnNames="policy_key, project_id" />

		<dropColumn tableName="policies"
			columnName="old_policy_key" />

	</changeSet>
</databaseChangeLog>