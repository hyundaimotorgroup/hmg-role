<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet id="20240802_create_abac_policy_item"
		author="henrio septiano">
		<createTable ifNotExists="true"
			tableName="abac_policy_items">
			<column name="policy_item_id" type="bigint"
				autoIncrement="true">
				<constraints primaryKey="true" />
			</column>
			<column name="effect" type="varchar(20)">
				<constraints nullable="false" />
			</column>
			<column name="scope" type="varchar(255)">
				<constraints nullable="true" />
			</column>
			<column name="is_deleted" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="policy_id" type="bigint">
				<constraints nullable="false"
					foreignKeyName="fk_abac_policy_items"
					references="abac_policies(policy_id)" />
			</column>
			<column name="resource_set_action_id" type="bigint">
				<constraints nullable="false"
					foreignKeyName="fk_abac_policy_resource_set"
					references="resource_set_actions(id)" />
			</column>
			<column name="user_set_id" type="bigint">
				<constraints nullable="false"
					foreignKeyName="fk_abac_policy_user_set"
					references="user_sets(user_set_id)" />
			</column>
		</createTable>
	</changeSet>
</databaseChangeLog>