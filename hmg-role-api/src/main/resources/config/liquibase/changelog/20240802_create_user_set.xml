<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet id="20240802_create_user_set"
		author="henrio septiano">
		<createTable ifNotExists="true" tableName="user_sets">
			<column name="user_set_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="condition_set_operator" type="varchar(50)">
				<constraints nullable="false" />
			</column>
			<column name="user_set_key" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="description" type="varchar(255)">
				<constraints nullable="true" />
			</column>
			<column name="is_deleted" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="project_id" type="bigint">
				<constraints nullable="false"
					foreignKeyName="fk_abac_user_set_project"
					references="projects(project_id)" />
			</column>
		</createTable>
	</changeSet>
</databaseChangeLog>