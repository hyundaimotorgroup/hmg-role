<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="20240816_rename_column_resource_type_name"
		author="Farhan Furqan">

		<dropNotNullConstraint
			columnDataType="varchar(255)" columnName="resource_type_name"
			tableName="resource_types" />

		<renameColumn tableName="resource_types"
			oldColumnName="resource_type_name"
			newColumnName="resource_type_description"
			columnDataType="varchar(255)" />

	</changeSet>
</databaseChangeLog>