<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="20241002_add_column_user_set_parent_id"
		author="henrio septiano">
		<addColumn tableName="user_sets">
			<column name="parent_id" type="bigint" />
		</addColumn>
		<addForeignKeyConstraint
			baseTableName="user_sets" baseColumnNames="parent_id"
			constraintName="fk_parent_user_set" referencedTableName="user_sets"
			referencedColumnNames="id" />
	</changeSet>
</databaseChangeLog>