<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet id="20250314_create_index"
		author="henrio septiano">
		<preConditions onFail="MARK_RAN">
			<not>
				<indexExists indexName="ix_members_api_key_is_deleted" />
				<indexExists indexName="ix_policy_item_role_is_deleted" />
				<indexExists
					indexName="ix_resource_actions_action_name_is_deleted" />
				<indexExists
					indexName="ix_resource_types_resource_type_key_is_deleted" />
				<indexExists indexName="ix_rbac_policies_is_deleted" />
				<indexExists indexName="ix_users_user_key_is_deleted" />
			</not>
		</preConditions>
		<createIndex indexName="ix_members_api_key_is_deleted"
			tableName="members">
			<column name="api_key" />
			<column name="is_deleted" />
		</createIndex>
		<createIndex indexName="ix_policy_item_role_is_deleted"
			tableName="rbac_policy_items">
			<column name="role_name" />
			<column name="is_deleted" />
		</createIndex>
		<createIndex
			indexName="ix_resource_actions_action_name_is_deleted"
			tableName="resource_actions">
			<column name="action_name" />
			<column name="is_deleted" />
		</createIndex>
		<createIndex
			indexName="ix_resource_types_resource_type_key_is_deleted"
			tableName="resource_types">
			<column name="resource_type_key" />
			<column name="is_deleted" />
		</createIndex>
		<createIndex indexName="ix_rbac_policies_is_deleted"
			tableName="rbac_policies">
			<column name="is_deleted" />
		</createIndex>
		<createIndex tableName="users"
			indexName="ix_users_user_key_is_deleted">
			<column name="user_key" />
			<column name="is_deleted" />
		</createIndex>
	</changeSet>
</databaseChangeLog>