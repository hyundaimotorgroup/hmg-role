<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet id="20250321_create_table_resource_type_tag"
		author="henrio septiano">
		<createTable tableName="resource_type_tags">
			<column name="id" type="bigint" autoIncrement="true">
				<constraints nullable="false" primaryKey="true" />
			</column>
			<column name="resource_type_id" type="bigint"
				autoIncrement="false">
				<constraints nullable="false" />
			</column>
			<column name="tag" type="VARCHAR(50)">
				<constraints nullable="false" />
			</column>
			<column name="is_delete" type="boolean">
				<constraints nullable="false" />
			</column>
		</createTable>
	</changeSet>
</databaseChangeLog>