<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet
		id="20250514_rename_column_roles_name_to_key_and_add_column_name"
		author="rizki nabil aufa">
		<renameColumn columnDataType="varchar(255)"
			newColumnName="role_key" oldColumnName="role_name" tableName="roles" />

		<addColumn tableName="roles">
			<column name="role_name" type="varchar(255)" />
		</addColumn>
	</changeSet>
</databaseChangeLog>